#!/usr/bin/env python3
"""gbot-slack — tiny Slack Web API CLI for bot-token agents (stdlib + optional websockets)."""

from __future__ import annotations

import argparse
import asyncio
import atexit
import json
import os
import signal
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Callable, Dict, Iterable, List, Optional, Set

SLACK_API = "https://slack.com/api"
DEFAULT_CONFIG_DIR = Path.home() / ".config" / "gbot-slack"
DEFAULT_TOKEN_PATH = DEFAULT_CONFIG_DIR / "bot-token"
DEFAULT_APP_TOKEN_PATH = DEFAULT_CONFIG_DIR / "app-token"
DEFAULT_PIDFILE = DEFAULT_CONFIG_DIR / "gateway.pid"
USER_AGENT = "gbot-slack/3.0"
VERSION = "3.0"
DEFAULT_THINKING_STATUS = "is thinking..."

# Known Events API types we intentionally do not wake on (not "unknown").
KNOWN_IGNORE_EVENT_TYPES = frozenset({"assistant_thread_context_changed"})


class SlackError(Exception):
    """Slack API or local configuration error."""


def resolve_token() -> str:
    env_token = os.environ.get("SLACK_BOT_TOKEN", "").strip()
    if env_token:
        return env_token
    file_path = os.environ.get("GBOT_SLACK_TOKEN_FILE", "").strip()
    path = Path(file_path).expanduser() if file_path else DEFAULT_TOKEN_PATH
    if path.is_file():
        token = path.read_text(encoding="utf-8").strip()
        if token:
            return token
    raise SlackError(
        "No bot token found. Set SLACK_BOT_TOKEN, or GBOT_SLACK_TOKEN_FILE, "
        f"or put the token in {DEFAULT_TOKEN_PATH}"
    )


def resolve_app_token() -> str:
    env_token = os.environ.get("SLACK_APP_TOKEN", "").strip()
    if env_token:
        return env_token
    file_path = os.environ.get("GBOT_SLACK_APP_TOKEN_FILE", "").strip()
    path = Path(file_path).expanduser() if file_path else DEFAULT_APP_TOKEN_PATH
    if path.is_file():
        token = path.read_text(encoding="utf-8").strip()
        if token:
            return token
    raise SlackError(
        "No app-level token found. Set SLACK_APP_TOKEN, or GBOT_SLACK_APP_TOKEN_FILE, "
        f"or put the token in {DEFAULT_APP_TOKEN_PATH} "
        "(starts with xapp-; needs connections:write for Socket Mode)"
    )


def api_call(
    method: str,
    token: str,
    params: Optional[Dict[str, Any]] = None,
    *,
    as_json: bool = False,
) -> Dict[str, Any]:
    payload = {k: v for k, v in (params or {}).items() if v is not None}
    if as_json:
        body: Optional[bytes] = json.dumps(payload).encode("utf-8")
        content_type = "application/json; charset=utf-8"
    else:
        body = (
            urllib.parse.urlencode(payload, doseq=True).encode("utf-8") if payload else None
        )
        content_type = "application/x-www-form-urlencoded; charset=utf-8"
    request = urllib.request.Request(
        f"{SLACK_API}/{method}",
        data=body,
        method="POST",
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": content_type,
            "User-Agent": USER_AGENT,
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            raw = response.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise SlackError(f"HTTP {exc.code} calling {method}: {detail}") from exc
    except urllib.error.URLError as exc:
        raise SlackError(f"Network error calling {method}: {exc.reason}") from exc

    try:
        data = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise SlackError(f"Invalid JSON from {method}") from exc
    if not data.get("ok"):
        parts = [f"Slack API error from {method}: {data.get('error', 'unknown_error')}"]
        if data.get("needed"):
            parts.append(f"needed={data['needed']}")
        if data.get("provided"):
            parts.append(f"provided={data['provided']}")
        raise SlackError(" ".join(parts))
    return data


def paginate(
    method: str,
    token: str,
    params: Optional[Dict[str, Any]] = None,
    collection_key: str = "channels",
    page_size: int = 200,
) -> List[Dict[str, Any]]:
    items: List[Dict[str, Any]] = []
    cursor = ""
    base = dict(params or {})
    base["limit"] = str(page_size)
    while True:
        if cursor:
            base["cursor"] = cursor
        else:
            base.pop("cursor", None)
        data = api_call(method, token, base)
        items.extend(data.get(collection_key) or [])
        cursor = (data.get("response_metadata") or {}).get("next_cursor") or ""
        if not cursor:
            return items


def looks_like_channel_id(value: str) -> bool:
    return len(value) >= 2 and value[0] in {"C", "D", "G"} and value[1:].isalnum()


def resolve_channel_id(token: str, channel: str) -> str:
    name = channel.strip()
    if not name:
        raise SlackError("Channel is required")
    if looks_like_channel_id(name):
        return name
    if name.startswith("#"):
        name = name[1:]
    channels = paginate(
        "conversations.list",
        token,
        {"types": "public_channel,private_channel,mpim,im", "exclude_archived": "true"},
    )
    lowered = name.lower()
    for entry in channels:
        if (entry.get("name") or "").lower() == lowered:
            return entry["id"]
    raise SlackError(
        f"Channel #{name} not found among conversations this bot can see. "
        "Invite the bot or use a channel ID (C…/D…/G…)."
    )


def normalize_emoji(name: str) -> str:
    emoji = name.strip()
    if not emoji:
        raise SlackError("Emoji name is required (without colons, e.g. eyes)")
    if emoji.startswith(":") and emoji.endswith(":") and len(emoji) > 2:
        emoji = emoji[1:-1]
    return emoji


def print_json(data: Any) -> None:
    json.dump(data, sys.stdout, indent=2, sort_keys=True)
    sys.stdout.write("\n")


def print_json_line(data: Any) -> None:
    json.dump(data, sys.stdout, sort_keys=True, separators=(",", ":"))
    sys.stdout.write("\n")
    sys.stdout.flush()


def require_limit(value: Optional[int], default: int = 20) -> int:
    limit = default if value is None else value
    if limit < 1:
        raise SlackError("limit must be >= 1")
    return limit


def cmd_whoami(token: str, _args: argparse.Namespace) -> int:
    data = api_call("auth.test", token)
    print_json(
        {
            "ok": True,
            "url": data.get("url"),
            "team": data.get("team"),
            "user": data.get("user"),
            "team_id": data.get("team_id"),
            "user_id": data.get("user_id"),
            "bot_id": data.get("bot_id"),
        }
    )
    return 0


def cmd_send(token: str, args: argparse.Namespace) -> int:
    text = " ".join(args.message).strip()
    if not text:
        raise SlackError("Message text is required")
    channel_id = resolve_channel_id(token, args.channel)
    data = api_call("chat.postMessage", token, {"channel": channel_id, "text": text})
    print_json(
        {
            "ok": True,
            "channel": data.get("channel"),
            "ts": data.get("ts"),
            "message": (data.get("message") or {}).get("text"),
        }
    )
    return 0


def cmd_history(token: str, args: argparse.Namespace) -> int:
    channel_id = resolve_channel_id(token, args.channel)
    limit = require_limit(args.limit)
    data = api_call("conversations.history", token, {"channel": channel_id, "limit": str(limit)})
    messages = [
        {
            "ts": message.get("ts"),
            "user": message.get("user") or message.get("bot_id"),
            "text": message.get("text"),
            "subtype": message.get("subtype"),
        }
        for message in (data.get("messages") or [])
    ]
    print_json({"ok": True, "channel": channel_id, "messages": messages})
    return 0


def cmd_channels(token: str, _args: argparse.Namespace) -> int:
    channels = paginate(
        "conversations.list",
        token,
        {"types": "public_channel,private_channel", "exclude_archived": "true"},
    )
    rows = [
        {
            "id": entry.get("id"),
            "name": entry.get("name"),
            "is_private": bool(entry.get("is_private")),
            "is_member": bool(entry.get("is_member")),
            "num_members": entry.get("num_members"),
        }
        for entry in channels
    ]
    rows.sort(key=lambda item: (item.get("name") or "").lower())
    print_json({"ok": True, "channels": rows})
    return 0


def cmd_dms(token: str, args: argparse.Namespace) -> int:
    limit = require_limit(args.limit)
    ims = paginate(
        "conversations.list",
        token,
        {"types": "im", "exclude_archived": "true"},
    )
    rows = []
    for entry in ims[:limit]:
        channel_id = entry.get("id")
        last_text = last_ts = last_user = None
        try:
            history = api_call(
                "conversations.history",
                token,
                {"channel": channel_id, "limit": "1"},
            )
            messages = history.get("messages") or []
            if messages:
                last = messages[0]
                last_text = last.get("text")
                last_ts = last.get("ts")
                last_user = last.get("user") or last.get("bot_id")
        except SlackError:
            pass
        rows.append(
            {
                "id": channel_id,
                "user": entry.get("user"),
                "last_ts": last_ts,
                "last_user": last_user,
                "last_text": last_text,
            }
        )
    print_json({"ok": True, "dms": rows})
    return 0


def cmd_mentions(token: str, args: argparse.Namespace) -> int:
    limit = require_limit(args.limit)
    auth = api_call("auth.test", token)
    query = f"<@{auth['user_id']}>" if auth.get("user_id") else f"@{auth.get('user') or ''}"
    try:
        data = api_call(
            "search.messages",
            token,
            {"query": query, "count": str(min(limit, 100)), "sort": "timestamp"},
        )
    except SlackError as exc:
        detail = str(exc)
        if any(code in detail for code in ("missing_scope", "not_allowed_token_type")):
            print(
                "search.messages is unavailable for this token (common for bot tokens).\n"
                "Prefer Socket Mode gateway/listen for mentions, or poll history:\n"
                "  - gbot-slack gateway --once\n"
                "  - gbot-slack listen [--once]\n"
                "  - invite the bot to channels of interest\n"
                "  - use: gbot-slack history CHANNEL [limit]\n"
                "  - or: gbot-slack channels / gbot-slack dms\n"
                f"Detail: {detail}",
                file=sys.stderr,
            )
            return 2
        raise
    matches = ((data.get("messages") or {}).get("matches")) or []
    rows = [
        {
            "channel": (match.get("channel") or {}).get("id")
            or (match.get("channel") or {}).get("name"),
            "ts": match.get("ts"),
            "user": match.get("user"),
            "text": match.get("text"),
            "permalink": match.get("permalink"),
        }
        for match in matches[:limit]
    ]
    print_json({"ok": True, "query": query, "mentions": rows})
    return 0


def cmd_react(token: str, args: argparse.Namespace) -> int:
    channel_id = resolve_channel_id(token, args.channel)
    emoji = normalize_emoji(args.emoji)
    api_call(
        "reactions.add",
        token,
        {"channel": channel_id, "timestamp": args.ts, "name": emoji},
    )
    print_json(
        {
            "ok": True,
            "channel": channel_id,
            "ts": args.ts,
            "emoji": emoji,
            "action": "add",
        }
    )
    return 0


def cmd_unreact(token: str, args: argparse.Namespace) -> int:
    channel_id = resolve_channel_id(token, args.channel)
    emoji = normalize_emoji(args.emoji)
    api_call(
        "reactions.remove",
        token,
        {"channel": channel_id, "timestamp": args.ts, "name": emoji},
    )
    print_json(
        {
            "ok": True,
            "channel": channel_id,
            "ts": args.ts,
            "emoji": emoji,
            "action": "remove",
        }
    )
    return 0


def cmd_thinking(token: str, args: argparse.Namespace) -> int:
    channel_id = resolve_channel_id(token, args.channel)
    if args.status is None or len(args.status) == 0:
        status = DEFAULT_THINKING_STATUS
    else:
        status = " ".join(args.status)
    params: Dict[str, Any] = {
        "channel_id": channel_id,
        "thread_ts": args.thread_ts,
        "status": status,
    }
    loading = list(args.loading or [])
    if loading:
        if len(loading) > 10:
            raise SlackError("loading_messages supports at most 10 strings")
        params["loading_messages"] = loading
    api_call("assistant.threads.setStatus", token, params, as_json=True)
    print_json(
        {
            "ok": True,
            "channel": channel_id,
            "thread_ts": args.thread_ts,
            "status": status,
            "loading_messages": loading or None,
        }
    )
    return 0


def _pid_is_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def acquire_pidfile(path: Path = DEFAULT_PIDFILE) -> Path:
    """Exclusive single-instance lock for Socket Mode (Slack load-balances connections)."""
    path = path.expanduser()
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file():
        raw = path.read_text(encoding="utf-8").strip()
        try:
            existing = int(raw)
        except ValueError:
            existing = -1
        if existing != os.getpid() and _pid_is_alive(existing):
            raise SlackError(
                f"Another gbot-slack gateway/listen is already running (pid {existing}, "
                f"pidfile {path}). Stop that process first — Slack Socket Mode "
                "load-balances events across connections, so multiple listeners steal events."
            )
    path.write_text(f"{os.getpid()}\n", encoding="utf-8")

    def _cleanup() -> None:
        release_pidfile(path)

    atexit.register(_cleanup)
    return path


def release_pidfile(path: Path = DEFAULT_PIDFILE) -> None:
    path = path.expanduser()
    try:
        if not path.is_file():
            return
        raw = path.read_text(encoding="utf-8").strip()
        if raw == str(os.getpid()):
            path.unlink()
    except OSError:
        pass


def _is_retry_envelope(envelope: Dict[str, Any]) -> bool:
    # Socket Mode often sends retry_attempt=0 (and empty retry_reason) on the
    # first delivery; only real retries have attempt > 0 or a non-empty reason.
    attempt = envelope.get("retry_attempt")
    if isinstance(attempt, int) and attempt > 0:
        return True
    reason = envelope.get("retry_reason")
    if isinstance(reason, str) and reason:
        return True
    return False


def _event_log_fields(event: Dict[str, Any]) -> Dict[str, Any]:
    """Safe summary fields for events-log (never tokens)."""
    assistant = event.get("assistant_thread") or {}
    return {
        "type": event.get("type"),
        "subtype": event.get("subtype"),
        "user": event.get("user") or assistant.get("user_id"),
        "text": event.get("text"),
        "thread_ts": event.get("thread_ts") or assistant.get("thread_ts"),
        "channel": event.get("channel") or assistant.get("channel_id"),
        "bot_id": event.get("bot_id"),
    }


def append_events_log(path: Path, envelope: Dict[str, Any]) -> None:
    payload = envelope.get("payload") or {}
    event = payload.get("event") if isinstance(payload, dict) else None
    if not isinstance(event, dict):
        event = {}
    row = {
        "envelope_type": envelope.get("type"),
        **_event_log_fields(event),
    }
    path = path.expanduser()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as handle:
        json.dump(row, handle, sort_keys=True, separators=(",", ":"))
        handle.write("\n")


def _human_event_summary(
    envelope: Dict[str, Any],
    *,
    self_user_id: Optional[str] = None,
    self_bot_id: Optional[str] = None,
    allow_from: Optional[Iterable[str]] = None,
    on_unknown: Optional[Callable[[str], None]] = None,
) -> Optional[Dict[str, Any]]:
    """Return a compact summary for a human Events API wake event, or None to ignore.

    Ignores: retries, message subtypes, bot_id senders, the bot's own user_id,
    and humans not on allow_from (when that list is non-empty).
    Thread replies in DMs (message + thread_ts, no subtype) are kept.
    """
    if envelope.get("type") != "events_api":
        return None
    if _is_retry_envelope(envelope):
        return None
    payload = envelope.get("payload") or {}
    event = payload.get("event") or {}
    event_type = event.get("type")
    if not event_type:
        return None

    if event_type == "assistant_thread_started":
        assistant = event.get("assistant_thread") or {}
        user = assistant.get("user_id") or event.get("user")
        if not user:
            return None
        channel = assistant.get("channel_id") or event.get("channel")
        thread_ts = assistant.get("thread_ts") or event.get("thread_ts")
        text = event.get("text")
        ts = event.get("ts") or thread_ts
        bot_id = event.get("bot_id")
    elif event_type in {"message", "app_mention"}:
        if event_type == "message" and event.get("subtype"):
            return None
        user = event.get("user")
        bot_id = event.get("bot_id")
        channel = event.get("channel")
        ts = event.get("ts")
        text = event.get("text")
        thread_ts = event.get("thread_ts")
    elif event_type in KNOWN_IGNORE_EVENT_TYPES:
        return None
    else:
        if on_unknown is not None:
            on_unknown(str(event_type))
        return None

    if bot_id:
        return None
    if self_bot_id and (user == self_bot_id or bot_id == self_bot_id):
        return None
    if self_user_id and user == self_user_id:
        return None
    if not user:
        return None

    allowed: Optional[Set[str]] = None
    if allow_from is not None:
        allowed = {item for item in allow_from if item}
        if allowed and user not in allowed:
            return None

    return {
        "type": event_type,
        "event_type": event_type,
        "channel": channel,
        "user": user,
        "ts": ts,
        "text": text,
        "thread_ts": thread_ts,
    }


# Backward-compatible name used by older call sites / tests.
def _user_message_summary(
    envelope: Dict[str, Any],
    *,
    self_user_id: Optional[str] = None,
    self_bot_id: Optional[str] = None,
    allow_from: Optional[Iterable[str]] = None,
    on_unknown: Optional[Callable[[str], None]] = None,
) -> Optional[Dict[str, Any]]:
    return _human_event_summary(
        envelope,
        self_user_id=self_user_id,
        self_bot_id=self_bot_id,
        allow_from=allow_from,
        on_unknown=on_unknown,
    )


def _open_socket_url(app_token: str) -> str:
    data = api_call("apps.connections.open", app_token)
    url = data.get("url")
    if not url:
        raise SlackError("apps.connections.open returned no WebSocket URL")
    return url


def _post_webhook(url: str, payload: Dict[str, Any]) -> None:
    body = json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=body,
        method="POST",
        headers={
            "Content-Type": "application/json; charset=utf-8",
            "User-Agent": USER_AGENT,
        },
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            response.read()
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        raise SlackError(f"HTTP {exc.code} posting webhook: {detail}") from exc
    except urllib.error.URLError as exc:
        raise SlackError(f"Network error posting webhook: {exc.reason}") from exc


def _import_websockets():
    try:
        import websockets
        from websockets.exceptions import ConnectionClosed
    except ImportError as exc:
        raise SlackError(
            "Socket Mode requires the optional 'websockets' package. "
            "Install with: pip install websockets"
        ) from exc
    return websockets, ConnectionClosed


def _bot_identity(token: str) -> Dict[str, Optional[str]]:
    auth = api_call("auth.test", token)
    return {
        "user_id": auth.get("user_id"),
        "bot_id": auth.get("bot_id"),
    }


async def _socket_mode_run(
    *,
    app_token: str,
    self_user_id: Optional[str],
    self_bot_id: Optional[str],
    once: bool,
    stop: Dict[str, bool],
    allow_from: Optional[List[str]] = None,
    events_log: Optional[Path] = None,
    on_human: Optional[Callable[[Dict[str, Any]], None]] = None,
) -> int:
    """Reconnecting Socket Mode loop. Never treats disconnect as a --once success."""
    websockets, ConnectionClosed = _import_websockets()

    def _log_unknown(event_type: str) -> None:
        print(f"gbot-slack: ignoring unknown Events API type: {event_type}", file=sys.stderr)

    while not stop["flag"]:
        url = _open_socket_url(app_token)
        try:
            async with websockets.connect(url) as websocket:
                async for raw in websocket:
                    if stop["flag"]:
                        return 0
                    try:
                        envelope = json.loads(raw)
                    except json.JSONDecodeError:
                        continue
                    envelope_id = envelope.get("envelope_id")
                    if envelope_id:
                        await websocket.send(json.dumps({"envelope_id": envelope_id}))
                    envelope_type = envelope.get("type")
                    if envelope_type == "hello":
                        continue
                    if envelope_type == "disconnect":
                        # Reconnect; do not treat as --once completion.
                        break
                    if events_log is not None and envelope_type == "events_api":
                        try:
                            append_events_log(events_log, envelope)
                        except OSError as exc:
                            print(f"gbot-slack: events-log write failed: {exc}", file=sys.stderr)
                    summary = _human_event_summary(
                        envelope,
                        self_user_id=self_user_id,
                        self_bot_id=self_bot_id,
                        allow_from=allow_from,
                        on_unknown=_log_unknown,
                    )
                    if not summary:
                        continue
                    if on_human is not None:
                        on_human(summary)
                    else:
                        print_json_line(summary)
                    if once:
                        return 0
        except ConnectionClosed:
            if stop["flag"]:
                return 0
            # Dropped socket is not a human event — reconnect (including --once).
            continue
        if stop["flag"]:
            return 0
        # disconnect break or clean socket end: reconnect unless stopping
        continue
    return 0


def _install_stop_handlers(stop: Dict[str, bool], pidfile: Optional[Path]) -> Callable[[], None]:
    previous_int = signal.getsignal(signal.SIGINT)
    previous_term = signal.getsignal(signal.SIGTERM)

    def _handle(_signum: int, _frame: Any) -> None:
        stop["flag"] = True
        if pidfile is not None:
            release_pidfile(pidfile)

    signal.signal(signal.SIGINT, _handle)
    signal.signal(signal.SIGTERM, _handle)

    def _restore() -> None:
        signal.signal(signal.SIGINT, previous_int)
        signal.signal(signal.SIGTERM, previous_term)

    return _restore


def cmd_listen(token: str, args: argparse.Namespace) -> int:
    """Socket Mode listener. Bot token identifies self; app token opens the socket."""
    _import_websockets()
    app_token = resolve_app_token()
    identity = _bot_identity(token)
    pidfile = acquire_pidfile()
    once = bool(args.once)
    stop = {"flag": False}
    restore = _install_stop_handlers(stop, pidfile)
    try:
        return asyncio.run(
            _socket_mode_run(
                app_token=app_token,
                self_user_id=identity.get("user_id"),
                self_bot_id=identity.get("bot_id"),
                once=once,
                stop=stop,
            )
        )
    finally:
        restore()
        release_pidfile(pidfile)


def cmd_gateway(token: str, args: argparse.Namespace) -> int:
    """Channel transport only: Socket Mode in, JSON/webhook out. No model calls."""
    _import_websockets()
    app_token = resolve_app_token()
    identity = _bot_identity(token)
    pidfile = acquire_pidfile()
    once = bool(args.once)
    webhook = (args.webhook or "").strip() or None
    allow_from = list(args.allow_from or [])
    events_log = Path(args.events_log).expanduser() if args.events_log else None
    stop = {"flag": False}
    restore = _install_stop_handlers(stop, pidfile)

    def _emit(summary: Dict[str, Any]) -> None:
        print_json_line(summary)
        if webhook:
            _post_webhook(webhook, summary)

    try:
        return asyncio.run(
            _socket_mode_run(
                app_token=app_token,
                self_user_id=identity.get("user_id"),
                self_bot_id=identity.get("bot_id"),
                once=once,
                stop=stop,
                allow_from=allow_from or None,
                events_log=events_log,
                on_human=_emit,
            )
        )
    finally:
        restore()
        release_pidfile(pidfile)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="gbot-slack",
        description=(
            "External Slack channel adapter for a host agent (transport only — "
            "this CLI does not think or call a model). Bot token from "
            "SLACK_BOT_TOKEN, GBOT_SLACK_TOKEN_FILE, or "
            f"{DEFAULT_TOKEN_PATH}. Socket Mode gateway/listen also needs an app-level "
            f"token (SLACK_APP_TOKEN / {DEFAULT_APP_TOKEN_PATH})."
        ),
    )
    parser.add_argument(
        "--version",
        action="version",
        version=f"gbot-slack {VERSION}",
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("whoami", help="Call auth.test and print bot identity")
    send = sub.add_parser("send", help="Post a message with chat.postMessage")
    send.add_argument("channel", help="Channel ID (C…/D…/G…) or #name")
    send.add_argument("message", nargs="+", help="Message text")
    history = sub.add_parser("history", help="Fetch conversations.history")
    history.add_argument("channel", help="Channel ID (C…/D…/G…) or #name")
    history.add_argument("limit", nargs="?", type=int, default=20)
    dms = sub.add_parser("dms", help="List IM conversations and last message")
    dms.add_argument("limit", nargs="?", type=int, default=20)
    mentions = sub.add_parser(
        "mentions",
        help="Best-effort search for bot mentions (may require search scope)",
    )
    mentions.add_argument("limit", nargs="?", type=int, default=20)
    sub.add_parser("channels", help="List conversations the bot can see")

    react = sub.add_parser("react", help="Add an emoji reaction (reactions.add)")
    react.add_argument("channel", help="Channel ID (C…/D…/G…) or #name")
    react.add_argument("ts", help="Message timestamp")
    react.add_argument("emoji", help="Emoji name without colons (e.g. eyes)")
    unreact = sub.add_parser("unreact", help="Remove an emoji reaction (reactions.remove)")
    unreact.add_argument("channel", help="Channel ID (C…/D…/G…) or #name")
    unreact.add_argument("ts", help="Message timestamp")
    unreact.add_argument("emoji", help="Emoji name without colons (e.g. eyes)")

    thinking = sub.add_parser(
        "thinking",
        help=(
            "Set assistant thread status via assistant.threads.setStatus "
            "(modern assistant status; not RTM typing). Default status: "
            f"{DEFAULT_THINKING_STATUS!r}. Pass empty string to clear."
        ),
    )
    thinking.add_argument("channel", help="Channel ID (C…/D…/G…) or #name")
    thinking.add_argument("thread_ts", help="Thread timestamp")
    thinking.add_argument(
        "status",
        nargs="*",
        help=f"Status text (default: {DEFAULT_THINKING_STATUS!r}; use \"\" to clear)",
    )
    thinking.add_argument(
        "--loading",
        action="append",
        default=[],
        metavar="TEXT",
        help="Loading message to rotate (repeatable, max 10)",
    )

    listen = sub.add_parser(
        "listen",
        help=(
            "Socket Mode event stream (requires pip install websockets + app token). "
            "Ignores self/bot echoes; reconnects until a human event (or SIGINT). "
            "Prefer 'gateway' for turn-based hosts."
        ),
    )
    listen.add_argument(
        "--once",
        action="store_true",
        help="Exit after the first human message / app_mention (not on disconnect)",
    )

    gateway = sub.add_parser(
        "gateway",
        help=(
            "Socket Mode channel transport only (does not think / call a model); "
            "emits JSON or --once exit for the host agent"
        ),
        description=(
            "External channel adapter only: own the Slack Socket Mode websocket, "
            "filter bot echoes, emit one JSON human event per line (or exit on "
            "--once). Does not think, call a model, keep session memory, or invoke "
            "an agent runtime — the host agent wakes and responds via send/react/thinking."
        ),
    )
    gateway.add_argument(
        "--once",
        action="store_true",
        help="Exit 0 after the first human event (reconnects on dropped sockets)",
    )
    gateway.add_argument(
        "--webhook",
        metavar="URL",
        help="POST each human event JSON to URL (stays up unless --once)",
    )
    gateway.add_argument(
        "--allow-from",
        action="append",
        default=[],
        metavar="ID",
        help="Slack user ID allowlist (repeatable); if set, ignore other humans",
    )
    gateway.add_argument(
        "--events-log",
        metavar="PATH",
        help="Append raw envelope summaries for debugging (never logs tokens)",
    )
    return parser


COMMANDS = {
    "whoami": cmd_whoami,
    "send": cmd_send,
    "history": cmd_history,
    "dms": cmd_dms,
    "mentions": cmd_mentions,
    "channels": cmd_channels,
    "react": cmd_react,
    "unreact": cmd_unreact,
    "thinking": cmd_thinking,
    "listen": cmd_listen,
    "gateway": cmd_gateway,
}


def main(argv: Optional[Iterable[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(list(argv) if argv is not None else None)
    if not args.command:
        parser.print_help()
        return 0
    try:
        return COMMANDS[args.command](resolve_token(), args)
    except SlackError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
